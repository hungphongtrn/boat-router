{
  "name": "Peek CI",
  "url": "https://github.com/hungphongtrn/peek",
  "description": "Boat CI router for hungphongtrn/peek.",
  "public": false,
  "hook_attributes": { "url": "https://example.invalid/webhook", "active": true },
  "default_permissions": { "actions": "read", "administration": "write", "metadata": "read" },
  "default_events": ["workflow_job"],
  "request_oauth_on_install": false,
  "redirect_url": "https://example.invalid/setup/callback"
}
