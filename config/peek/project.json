{
  "id": "peek",
  "repo": "hungphongtrn/peek",
  "account": "peek",
  "reuse": {
    "mode": "on",
    "idleHoldSeconds": 5400,
    "idleHoldSecondsWhenStartsPaid": 1200
  },
  "caps": {
    "concurrent": 3
  },
  "labels": [
    "peek-router"
  ],
  "machineTtlSeconds": 28800,
  "jobs": {
    "ci": {
      "timeoutMinutes": 40
    },
    "shard": {
      "timeoutMinutes": 30
    },
    "ci-test-run": {
      "timeoutMinutes": 40
    },
    "promotion": {
      "timeoutMinutes": 30
    }
  },
  "landing": {
    "engine": "runner"
  },
  "sizes": {
    "peek-router": {
      "machine": "default"
    }
  },
  "triggers": [
    {
      "on": "workflow_job",
      "executor": "actions-jit"
    }
  ],
  "snapshotBoot": true,
  "workflowConcurrency": [
    {
      "workflowPath": ".github/workflows/ci.yml",
      "jobPrefix": "shard (",
      "maxParallel": 4
    }
  ]
}
