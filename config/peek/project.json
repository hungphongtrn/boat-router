{
  "id": "peek",
  "repo": "hungphongtrn/peek",
  "account": "peek",
  "reuse": {
    "mode": "on",
    "idleHoldSecondsWhenStartsPaid": 3600
  },
  "caps": {
    "concurrent": 2
  },
  "labels": [
    "peek-router",
    "peek-router-light"
  ],
  "machineTtlSeconds": 28800,
  "jobs": {
    "scope": {
      "timeoutMinutes": 20
    },
    "desktop": {
      "timeoutMinutes": 35
    },
    "rust": {
      "timeoutMinutes": 50
    },
    "checks": {
      "timeoutMinutes": 33
    },
    "web": {
      "timeoutMinutes": 22
    },
    "ci": {
      "timeoutMinutes": 50
    },
    "ci-test-run": {
      "timeoutMinutes": 36
    },
    "shard": {
      "timeoutMinutes": 30
    },
    "promotion": {
      "timeoutMinutes": 25
    },
    "publish": {
      "timeoutMinutes": 55
    },
    "ci-image": {
      "timeoutMinutes": 60
    }
  },
  "landing": {
    "engine": "runner"
  },
  "sizes": {
    "peek-router": {
      "machine": "default"
    },
    "peek-router-light": {
      "machine": "small"
    }
  },
  "triggers": [
    {
      "on": "workflow_job",
      "executor": "actions-jit"
    }
  ],
  "snapshotBoot": true,
  "rollingSnapshot": true,
  "workflowConcurrency": [
    {
      "workflowPath": ".github/workflows/ci.yml",
      "jobPrefix": "shard (",
      "maxParallel": 4
    }
  ]
}
