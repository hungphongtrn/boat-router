{
  "peek-runs": {
    "enabled": true,
    "project": "peek",
    "maxActive": 4,
    "ttlSeconds": 1800,
    "startsPerDay": 60,
    "rollingSnapshot": true,
    "warmReuse": false,
    "network": {
      "mode": "allow",
      "inbound": "boat-only",
      "allow": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "crates.io",
        "*.crates.io",
        "static.rust-lang.org",
        "*.rust-lang.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
